# OpenAI-compatible Provider
CLEODOC_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional LLM timeout overrides in milliseconds
# CLEODOC_LLM_CONNECT_TIMEOUT_MS=60000
# CLEODOC_LLM_STREAM_IDLE_TIMEOUT_MS=120000
# CLEODOC_LLM_OVERALL_TIMEOUT_MS=1200000

# Temporary capability overrides for models absent from the packaged catalog
# CLEODOC_MODEL_CONTEXT_TOKENS=1000000
# CLEODOC_MODEL_MAX_OUTPUT_TOKENS=384000

# Optional CLI state directory override (useful for tests and portable installs)
# CLEODOC_HOME=/path/to/cleodoc-state
