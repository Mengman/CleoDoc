{
  "name": "cleodoc",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Chinese novel AI principal writer",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./out/main/index.js",
  "bin": {
    "cleo": "./dist/apps/cli/src/main.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "desktop:build": "electron-vite build",
    "desktop:dev": "electron-vite dev",
    "desktop:preview": "electron-vite preview",
    "package:cli": "npm run build && node scripts/package-cli.mjs",
    "cleo": "tsx apps/cli/src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.1.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": {
      "nanoid": "3.3.17"
    }
  }
}
